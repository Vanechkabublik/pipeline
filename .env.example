# Режим: development | production | test
NODE_ENV=development
# Порт HTTP API (и порт, который docker compose пробрасывает наружу)
PORT=3000

# PostgreSQL. Для локальной разработки (npm run start:dev) — localhost.
# Внутри docker compose сервис api сам подменяет DB_HOST на "db" и DB_PORT на 5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dozakrytiya
DB_PASSWORD=dozakrytiya
DB_NAME=dozakrytiya
# Отдельная БД для e2e-тестов (создаётся автоматически перед тестами)
DB_NAME_TEST=dozakrytiya_test

# Секрет подписи JWT (минимум 32 символа)
JWT_SECRET=change-me-to-a-long-random-string-32+
# Секрет HMAC-подписи вебхуков платёжного провайдера (минимум 16 символов)
WEBHOOK_SECRET=change-me-webhook-secret
# Разрешённый origin фронтенда для CORS (с credentials: true нельзя "*")
CORS_ORIGIN=http://localhost:5173
# Сколько секунд живёт неоплаченная бронь (RESERVED)
BOOKING_HOLD_SECONDS=600
